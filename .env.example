# Firebase web config — copy this file to ".env" and fill in YOUR OWN
# free-tier Firebase project values (Firebase Console → Project settings).
# Never commit a real .env file. See SECURITY.md.
#
# Note: a Firebase web apiKey is an identifier, not a password — but your
# project still needs strict Firestore Security Rules before any deployment.

EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
