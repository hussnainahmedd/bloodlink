{
  "main": "expo-router/entry",
  "name": "bloodlink",
  "version": "1.0.0",
  "description": "BloodLink — emergency blood donor matching for Pakistan. Android, iOS, and Web from one Expo + TypeScript codebase.",
  "license": "MIT",
  "author": "Hussnain Ahmad (https://github.com/hussnainahmedd)",
  "homepage": "https://github.com/hussnainahmedd/bloodlink#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hussnainahmedd/bloodlink.git"
  },
  "bugs": {
    "url": "https://github.com/hussnainahmedd/bloodlink/issues"
  },
  "keywords": [
    "blood-donation",
    "expo",
    "react-native",
    "typescript",
    "firebase",
    "donor-matching",
    "pakistan",
    "healthcare"
  ],
  "private": true,
  "scripts": {
    "android": "expo start --android",
    "ios": "expo start --ios",
    "start": "expo start",
    "typecheck": "tsc --noEmit",
    "web": "expo start --web",
    "build": "expo export --platform web",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@expo-google-fonts/fraunces": "^0.4.1",
    "@expo-google-fonts/ibm-plex-mono": "^0.4.1",
    "@expo-google-fonts/inter": "^0.4.2",
    "expo": "^57.0.26",
    "expo-constants": "~57.0.19",
    "expo-font": "~57.0.4",
    "expo-linking": "~57.0.11",
    "expo-router": "~58.0.13",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "nativewind": "^4.2.7",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.28.0",
    "react-native-svg": "15.15.5",
    "react-native-web": "^0.21.3",
    "react-native-worklets": "^0.13.0",
    "tailwindcss": "^3.4.19"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
